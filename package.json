{
  "name": "peisar",
  "version": "0.2.0",
  "description": "A practical Markdown parser written in Rust",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "build:local": "napi build --platform --config-path napi.config.json --output-dir local_build",
    "test": "bash scripts/wf_tests.sh",
    "hooks:install": "bash scripts/install-hooks.sh",
    "commit": "bash scripts/commit.sh",
    "wf:test": "bash scripts/wf_tests.sh"
  },
  "keywords": [
    "markdown",
    "parser"
  ],
  "type": "commonjs",
  "devDependencies": {
    "@napi-rs/cli": "^3.10.5"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phothinmg/peisar"
  },
  "files": [
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    "index.js",
    "index.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  }
}
