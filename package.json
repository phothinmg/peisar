{
  "name": "peisar",
  "version": "1.2.0",
  "description": "A practical Markdown parser written in Rust",
  "main": "index.cjs",
  "types": "index.d.ts",
  "module": "index.mjs",
  "browser": "browser/peisar.js",
  "exports": {
    ".": {
      "require": {
        "default": "./index.cjs",
        "types": "./index.d.ts"
      },
      "import": {
        "default": "./index.mjs",
        "types": "./index.d.ts"
      }
    }
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "local:build": "bash scripts/local_build.sh",
    "ssg:build": "bash scripts/ssg_build.sh",
    "hooks:install": "bash scripts/install-hooks.sh",
    "commit": "bash scripts/commit.sh",
    "wf:test": "bash scripts/wf_tests.sh",
    "js:test": "bash scripts/js_tests.sh",
    "benchmark": "cd bench && npm run bench",
    "fix:gpg": "bash scripts/gpg.sh"
  },
  "keywords": [
    "markdown",
    "parser"
  ],
  "type": "module",
  "devDependencies": {
    "@emnapi/core": "^2.0.0-alpha.5",
    "@emnapi/runtime": "^2.0.0-alpha.5",
    "@napi-rs/cli": "^3.9.1",
    "emnapi": "^2.0.0-alpha.5"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phothinmg/peisar"
  },
  "files": [
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    "index.cjs",
    "index.mjs",
    "index.d.ts",
    "package.json",
    "browser"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=23.5.0 || ^24.21.0"
  }
}
