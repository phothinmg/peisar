{
  "name": "peisar",
  "version": "2.0.1",
  "gitHead": "fefe667d38f40eef5ba2b33df555d0ada4a9971b",
  "description": "A practical Markdown parser engineered in Rust",
  "keywords": [
    "markdown",
    "parser"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phothinmg/peisar"
  },
  "files": [
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    "index.cjs",
    "index.mjs",
    "index.d.ts",
    "package.json",
    "browser",
    "prisar.webp"
  ],
  "type": "module",
  "main": "index.cjs",
  "module": "index.mjs",
  "browser": "browser/peisar.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "require": {
        "default": "./index.cjs",
        "types": "./index.d.ts"
      },
      "import": {
        "default": "./index.mjs",
        "types": "./index.d.ts"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "test": "bash scripts/tests.sh",
    "example:build": "bash scripts/example_build.sh",
    "hooks:install": "bash scripts/install-hooks.sh",
    "commit": "bash scripts/commit.sh",
    "benchmark": "bash scripts/benchmark.sh",
    "fix:gpg": "bash scripts/gpg.sh"
  },
  "devDependencies": {
    "@emnapi/core": "^2.0.0-alpha.5",
    "@emnapi/runtime": "^2.0.0-alpha.5",
    "@napi-rs/cli": "^3.9.1",
    "emnapi": "^2.0.0-alpha.5",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=23.5.0 || ^24.21.0"
  }
}
